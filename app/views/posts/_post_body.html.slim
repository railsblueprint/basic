- show_full = local_assigns[:show_full].to_b
- body_id = show_full ? "#{dom_id(post)}_body" : "#{dom_id(post)}_preview"
div id=body_id
  .card-title = link_to post.title, post_path(id: post.slug)
  .card-text
    - if show_full
      == post.body
    - elsif post.cutline?
      == post.teaser
      p.text-muted.small.mt-2
        = link_to t("posts.post.read_more"), post_path(id: post.slug), class: "text-decoration-none"
    - else
      - preview = post.body.to_plain_text
      = truncate(preview, length: 300)
      - if preview.length > 300
        p.text-muted.small.mt-2
          = link_to t("posts.post.read_more"), post_path(id: post.slug), class: "text-decoration-none"

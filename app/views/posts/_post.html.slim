div data-controller="post" data-post-id-value=post.id
  .card.post id=dom_id(post)
    .card-body
      = render "posts/post_body", post: post, show_full: local_assigns[:show_full]

    .card-footer.justify-content-between.actions
      .actions
        - if post.user
          div.pt-1
            i.bi.bi-person
            '
            = link_to post.user&.full_name, post.user
        div.pt-1
          i.bi.bi-clock
          '
          = post.created_at.strftime("%d %B, %Y %H:%M")
      - unless local_assigns[:no_controls].to_b
        .actions.justify-content-end
          = edit_button(post)
          = delete_button(post)
